# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.cz
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.cz
DJANGO_USE_HTTPS=true

# Database
POSTGRES_DB=ples
POSTGRES_USER=ples
POSTGRES_PASSWORD=change-me

# Host port of the web container (put a reverse proxy with HTTPS in front of it)
WEB_PORT=8005

# E-mail (use django.core.mail.backends.console.EmailBackend to print e-mails to the log)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Ples UTB <ples@sutb.cz>

# Year of the ball written in the e-mails
BALL_YEAR=2026
